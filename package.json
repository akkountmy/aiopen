{
  "name": "dsh-open-web",
  "version": "1.0.0",
  "private": true,
  "description": "Закрытый веб-сервис рабочего пространства: вход по логину и паролю, проекты, файлы, распознавание документов и изображений.",
  "type": "module",
  "main": "server.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "smoke": "node test/smoke.mjs",
    "test:docs": "node test/docs.mjs",
    "test:docpreview": "node --test test/docpreview.mjs",
    "test:runs": "node test/runs.mjs",
    "test:ui-runs": "node test/ui-runs.mjs",
    "test:ui-scroll": "node test/ui-scroll.mjs",
    "test:ui-sheet": "node test/ui-modal-sheet.mjs",
    "test:ui-swipe": "node test/ui-swipe.mjs",
    "test:ui-version": "node test/ui-version.mjs",
    "test:browser": "node test/browser.mjs",
    "test:browser-engines": "node test/browser-engines.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "docx": "^9.12.0",
    "exceljs": "^4.4.0",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.1",
    "pdfkit": "^0.20.2",
    "playwright-core": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^24.43.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "@sparticuz/chromium": "143.0.4"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
