{
  "name": "dsh-open-web",
  "version": "1.0.0",
  "private": true,
  "description": "Закрытый веб-сервис рабочего пространства: вход по логину и паролю, проекты, файлы, распознавание документов и изображений.",
  "type": "module",
  "main": "server.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "smoke": "node test/smoke.mjs",
    "test:docs": "node test/docs.mjs",
    "test:docpreview": "node --test test/docpreview.mjs",
    "test:runs": "node test/runs.mjs",
    "test:ui-runs": "node test/ui-runs.mjs",
    "test:ui-scroll": "node test/ui-scroll.mjs",
    "test:ui-swipe": "node test/ui-swipe.mjs",
    "test:ui-version": "node test/ui-version.mjs"
  },
  "dependencies": {
    "docx": "^9.12.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "playwright": "^1.48.0"
  }
}
